{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "设计素材库 catalog v3",
  "type": "object",
  "required": ["version", "updated", "entries"],
  "properties": {
    "version": {"const": 3},
    "updated": {"type": "string", "format": "date"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "slug", "title", "path", "files"],
        "properties": {
          "kind": {"enum": ["library", "styles"]},
          "slug": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "kind", "title", "license", "spdx", "sha256", "bytes", "ai_used"],
              "properties": {
                "path": {"type": "string"},
                "kind": {"enum": ["official", "reference", "asset", "tool-test"]},
                "source_url": {"type": "string"},
                "author": {"type": "string"},
                "license": {"type": "string", "description": "人读的原始许可说明"},
                "spdx": {"type": "string", "pattern": "^(LicenseRef-[A-Za-z0-9.-]+|[A-Za-z0-9.+-]+)$"},
                "attribution_required": {"type": "boolean"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": "integer", "minimum": 0},
                "ai_used": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
